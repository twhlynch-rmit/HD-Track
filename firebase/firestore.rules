rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Role checked against Firestore document (not custom claims).
    // For performance-critical rules, use hasCustomClaim() instead.
    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated()
        && exists(userPath)
        && get(userPath).data.role == 'admin';
    }

    // Role checked against Firebase Auth custom claims — no Firestore read needed.
    // Set custom claims via Admin SDK: adminAuth.setCustomUserClaims(uid, { admin: true })
    function hasCustomClaim(claim) {
      return isAuthenticated() && request.auth.token[claim] == true;
    }

    // Soft-delete guard — filters out logically deleted documents.
    // Include in read rules: allow read: if isOwner(userId) && notDeleted();
    function notDeleted() {
      return resource == null || !('deletedAt' in resource.data) || resource.data.deletedAt == null;
    }

    // ── Collections ────────────────────────────────────────────────────────

    // users/{userId}
    // Each user can only read and update their own profile.
    // Admins can read any profile.
    // Creation is triggered by AuthProvider on first sign-in (syncUserProfile).
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin()) && notDeleted();

      allow create: if isAuthenticated() && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'email', 'role', 'createdAt', 'updatedAt', '_schemaVersion'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt', '_schemaVersion'])
        && request.resource.data.role == 'user';  // only admin SDK can set 'admin' role

      allow update: if isAuthenticated() && isOwner(userId)
        && request.resource.data.uid == resource.data.uid    // uid is immutable
        && request.resource.data.role == resource.data.role  // role is immutable by user
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt', '_schemaVersion']);

      allow delete: if false; // soft-delete only — set deletedAt field instead
    }

    // Add new collection rules above this comment using the /firebase-collection skill.

    // locations/{locationId}
    // Reference data for the Locator feature.
    //
    // Fully server-owned: the seed script and the /api/locations/nearby Route
    // Handler read it with the Admin SDK, which bypasses these rules. Client
    // access is denied outright, so coordinates and `active` cannot be forged
    // and every search goes through one authenticated, validated endpoint.
    match /locations/{locationId} {
      allow read, write: if false;
    }

    // visits/{visitId}
    // One document per visit a user logs against a location.
    //
    // This is the feature's non-trivial rules layer. A client can only:
    //   - read its own visits
    //   - create one document, once, with an exact key set
    //   - only for a location that exists and is active
    //   - with the location name matching that location's source of truth
    //   - with server timestamps only
    // Nothing can ever be updated or deleted.
    match /visits/{visitId} {
      allow read: if isAuthenticated() && isOwner(resource.data.uid) && notDeleted();

      allow create: if isAuthenticated()
        && isOwner(request.resource.data.uid)
        && request.resource.data.keys().hasAll(['uid', 'locationId', 'locationName', 'visitedAt', 'createdAt', '_schemaVersion'])
        && request.resource.data.keys().hasOnly(['uid', 'locationId', 'locationName', 'visitedAt', 'createdAt', '_schemaVersion'])
        && request.resource.data.locationId is string
        && request.resource.data.locationId.size() > 0
        && request.resource.data.locationId.size() <= 128
        && request.resource.data.locationName is string
        && request.resource.data.locationName.size() > 0
        && request.resource.data.locationName.size() <= 200
        && request.resource.data._schemaVersion == 1
        && request.resource.data.visitedAt == request.time
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/locations/$(request.resource.data.locationId))
        && get(/databases/$(database)/documents/locations/$(request.resource.data.locationId)).data.active == true
        && request.resource.data.locationName == get(/databases/$(database)/documents/locations/$(request.resource.data.locationId)).data.name;

      allow update, delete: if false;
    }

    // ── Default deny ───────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
